Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 35; 35; 35
    Frame Rate: 20
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Corridor Navigation Map
      Enabled: true
      Alpha: 0.5
      Color Scheme: map
      Topic:
        Value: /map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Path
      Name: Executable Navigation Path
      Enabled: true
      Color: 0; 255; 255
      Line Style: Lines
      Line Width: 0.03
      Topic:
        Value: /navigation/display_plan
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Marker
      Name: Navigation Robot Position
      Enabled: true
      Topic:
        Value: /navigation/robot_position
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Grid
      Name: Ground Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 80
      Reference Frame: map
    - Class: rviz_default_plugins/PointCloud2
      Name: Reference Surface (gray)
      Enabled: true
      Topic:
        Value: /localization/reference_map
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color Transformer: FlatColor
      Color: 170; 170; 170
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 2
      Alpha: 0.5
    - Class: rviz_default_plugins/PointCloud2
      Name: Aligned Lidar (green)
      Enabled: true
      Topic:
        Value: /localization/aligned_cloud
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 2
      Color Transformer: FlatColor
      Color: 0; 255; 80
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Decay Time: 0
    - Class: rviz_default_plugins/Axes
      Name: Estimated Robot Pose
      Enabled: true
      Reference Frame: localization_base_link
      Length: 0.6
      Radius: 0.04
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Target Frame: map
      Distance: 16
      Pitch: 0.65
      Yaw: 0.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0.5
